# Drime Cloud API Token
# Get yours at: https://app.drime.cloud/settings/developers
# Required: yes
DRIME_API_TOKEN=your_token_here

# Read-only mode is ON by default (secure-by-default).
# Set to exactly "false" to enable write operations (upload, delete, move, create folder).
# Any other value — including typos — keeps the server read-only.
# DRIME_READ_ONLY=false
